# ============================================================
# 交互式旅行规划智能体 · 环境变量样例
# 复制为 .env 后按需修改。默认配置无需任何外部服务即可运行。
# ============================================================

# ---- 运行模式 ----
# mock  = 零成本/离线演示（默认，答辩与本地测试推荐）
# openai= 调用真实 OpenAI 兼容大模型（DeepSeek / 通义千问等）
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

# ---- 数据存储 ----
# 默认 SQLite（零依赖）。生产可替换为 mysql+aiomysql://user:pwd@mysql:3306/travel
DATABASE_URL=sqlite+aiosqlite:///./travelagent.db

# ---- 缓存 / 限流 / 锁 / 幂等 后端 ----
# memory = 进程内实现（默认，零依赖）；redis = 使用真实 Redis
KV_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# ---- JWT ----
JWT_SECRET=travel-agent-dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---- 限流 ----
RATE_LIMIT_PER_USER_PER_MINUTE=10
RATE_LIMIT_GLOBAL_QPS=200
LLM_MAX_CONCURRENCY=20

# ---- 熔断 ----
BREAKER_WINDOW_SECONDS=10
BREAKER_FAILURE_THRESHOLD=0.5
BREAKER_MIN_SAMPLES=5
BREAKER_COOLDOWN_SECONDS=30
BREAKER_HALF_OPEN_PROBES=3

# ---- 重试 ----
RETRY_MAX_ATTEMPTS=2
RETRY_BASE_DELAY=0.5
RETRY_JITTER=0.2

# ---- 幂等 / 锁 ----
IDEMPOTENCY_TTL_SECONDS=600
PLAN_LOCK_TTL_SECONDS=60
PLAN_LOCK_WATCHDOG_INTERVAL=20

# ---- 会话 / 记忆 ----
SESSION_TTL_SECONDS=7200
CONTEXT_MAX_TURNS=8
PLAN_TIMEOUT_SECONDS=120
REVISION_MAX=3

# ---- RAG ----
RAG_ENABLED=true
RAG_TOPK=5
RAG_CHUNK_SIZE=380
RAG_CHUNK_OVERLAP=50
RAG_SCORE_THRESHOLD=0.18
EMBEDDING_PROVIDER=hash   # hash = 本地确定性向量（默认）；openai = 调用真实 embedding

# ---- Token 配额 ----
TOKEN_DAILY_QUOTA=100000

# ---- 跨域 ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
